{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "noEmit": true,
        "noUncheckedIndexedAccess": false,
        "rootDir": ".",
        "types": [
            "node",
            "vitest/globals"
        ],
        "paths": {
            "hono-status-monitor": [
                "./src/index.ts"
            ],
            "hono-status-monitor/edge": [
                "./src/index-edge.ts"
            ],
            "hono-status-monitor/otel": [
                "./src/otel.ts"
            ],
            "hono-status-monitor/durable-object": [
                "./src/durable-object-store.ts"
            ]
        }
    },
    "include": [
        "src/**/*",
        "tests/**/*",
        "examples/**/*"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "examples/bun.ts",
        "examples/deno.ts"
    ]
}
