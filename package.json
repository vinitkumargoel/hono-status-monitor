{
    "name": "hono-status-monitor",
    "version": "1.1.0",
    "description": "Real-time server monitoring dashboard for Hono.js. Works with Node.js, Bun, and Cloudflare Workers. Express-status-monitor style metrics with polling updates.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./edge": {
            "types": "./dist/index-edge.d.ts",
            "import": "./dist/index-edge.js",
            "default": "./dist/index-edge.js"
        }
    },
    "files": [
        "dist",
        "!dist/**/*.map"
    ],
    "scripts": {
        "build": "tsc && node scripts/minify-assets.mjs",
        "prepublishOnly": "npm run build",
        "clean": "rm -rf dist",
        "test": "vitest run"
    },
    "keywords": [
        "hono",
        "status",
        "monitor",
        "dashboard",
        "metrics",
        "real-time",
        "performance",
        "cloudflare",
        "workers",
        "edge",
        "bun",
        "express-status-monitor"
    ],
    "author": "Vinit Kumar Goel",
    "email": "vinit928@gmail.com",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vinitkumargoel/hono-status-monitor.git"
    },
    "homepage": "https://github.com/vinitkumargoel/hono-status-monitor#readme",
    "bugs": {
        "url": "https://github.com/vinitkumargoel/hono-status-monitor/issues"
    },
    "peerDependencies": {
        "hono": ">=4.0.0"
    },
    "peerDependenciesMeta": {
        "@hono/node-server": {
            "optional": true
        }
    },
    "devDependencies": {
        "@hono/node-server": "^1.19.14",
        "@types/node": "^20.19.43",
        "esbuild": "^0.24.2",
        "hono": "^4.12.31",
        "typescript": "^5.9.3",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">=18.0.0",
        "bun": ">=1.0.0"
    }
}
