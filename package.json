{
    "name": "hono-status-monitor",
    "version": "2.0.0",
    "description": "Real-time server monitoring dashboard for Hono.js. Works with Node.js, Bun, Deno, Cloudflare Workers and Vercel Edge. Express-status-monitor style dashboard with live updates, Prometheus and health endpoints.",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "workerd": "./dist/index-edge.js",
            "edge-light": "./dist/index-edge.js",
            "import": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./edge": {
            "types": "./dist/index-edge.d.ts",
            "import": "./dist/index-edge.js",
            "default": "./dist/index-edge.js"
        },
        "./otel": {
            "types": "./dist/otel.d.ts",
            "import": "./dist/otel.js",
            "default": "./dist/otel.js"
        },
        "./durable-object": {
            "types": "./dist/durable-object-store.d.ts",
            "import": "./dist/durable-object-store.js",
            "default": "./dist/durable-object-store.js"
        }
    },
    "files": [
        "dist",
        "!dist/**/*.map"
    ],
    "sideEffects": false,
    "scripts": {
        "build": "tsc && node scripts/minify-assets.mjs",
        "prepack": "npm run build",
        "clean": "rm -rf dist",
        "typecheck": "tsc -p tsconfig.test.json",
        "lint": "biome lint",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage",
        "smoke": "node scripts/smoke.mjs",
        "check:package": "publint && attw --pack . --profile esm-only",
        "check": "npm run typecheck && npm run lint && npm run test:coverage && npm run build && npm run smoke && npm run size && npm run check:package",
        "size": "node scripts/size-check.mjs",
        "smoke:workerd": "node scripts/workerd-smoke.mjs",
        "changeset": "changeset"
    },
    "keywords": [
        "hono",
        "status",
        "monitor",
        "dashboard",
        "metrics",
        "real-time",
        "performance",
        "cloudflare",
        "workers",
        "edge",
        "bun",
        "express-status-monitor"
    ],
    "author": "Vinit Kumar Goel",
    "email": "vinit928@gmail.com",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/vinitkumargoel/hono-status-monitor.git"
    },
    "homepage": "https://github.com/vinitkumargoel/hono-status-monitor#readme",
    "bugs": {
        "url": "https://github.com/vinitkumargoel/hono-status-monitor/issues"
    },
    "peerDependencies": {
        "hono": "^4.0.0"
    },
    "devDependencies": {
        "@arethetypeswrong/cli": "^0.18.5",
        "@biomejs/biome": "^2.5.14",
        "@changesets/cli": "^3.0.3",
        "@hono/node-server": "^1.19.14",
        "@types/jsdom": "^21.1.7",
        "@types/node": "^20.19.43",
        "@vitest/coverage-v8": "^4.1.11",
        "esbuild": "^0.28.2",
        "hono": "^4.12.31",
        "jsdom": "^26.1.0",
        "publint": "^0.3.24",
        "typescript": "^5.9.3",
        "vitest": "^4.1.10"
    },
    "engines": {
        "node": ">=20.0.0",
        "bun": ">=1.0.0"
    }
}
