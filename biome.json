{
    "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
    "files": {
        "includes": [
            "src/**",
            "tests/**",
            "scripts/**",
            "examples/**"
        ]
    },
    "formatter": {
        "enabled": false
    },
    "assist": {
        "enabled": false
    },
    "linter": {
        "enabled": true,
        "rules": {
            "recommended": true
        }
    },
    "overrides": [
        {
            "includes": [
                "tests/**"
            ],
            "linter": {
                "rules": {
                    "style": {
                        "noNonNullAssertion": "off"
                    },
                    "suspicious": {
                        "noTemplateCurlyInString": "off",
                        "noExplicitAny": "off"
                    }
                }
            }
        }
    ]
}
